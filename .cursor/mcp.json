{
  "mcpServers": {
    "confluence": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/orgwave/scripts/confluence-mcp-launch.mjs"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "https://confluence.myntracorp.com/"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "github": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/orgwave/scripts/github-mcp-launch.mjs"
      ],
      "envFile": "${workspaceFolder}/.env"
    }
  }
}

{
  "mcpServers": {
    "confluence": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/orgwave/mcp-confluence-runtime/node_modules/@answerai/confluence-mcp/build/index.js"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "https://confluence.myntracorp.com/"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "github": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/orgwave/scripts/github-mcp-launch.mjs"
      ],
      "envFile": "${workspaceFolder}/.env"
    }
  }
}

{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/orgwave/scripts/github-mcp-launch.mjs"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}",
        "GH_TOKEN": "${env:GH_TOKEN}"
      }
    }
  }
}

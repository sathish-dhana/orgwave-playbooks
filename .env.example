# Optional: PAT for @modelcontextprotocol/server-github (loaded via .cursor/mcp.json envFile).
# Copy to `.env` at the repo root (gitignored). See mcp-servers/README.md.
#
# If unset, github-mcp-launch.mjs tries ~/.cursor/github-mcp.env, then prefers `gh auth token` over
# GITHUB_TOKEN/GH_TOKEN from Cursor (so MCP matches `gh` in the terminal). Set ORGWAVE_MCP_PREFER_ENV_TOKEN=1
# to use env tokens before gh (e.g. CI PAT while gh is another account).

GITHUB_PERSONAL_ACCESS_TOKEN=ghp_replace_with_your_token
# ORGWAVE_MCP_PREFER_ENV_TOKEN=1
